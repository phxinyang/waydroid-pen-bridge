SUBSYSTEM!="input", GOTO="waydroid_pen_mode_end"
KERNEL!="event*", GOTO="waydroid_pen_mode_end"

# Desktop proxies stay visible to libinput and are never mounted into
# Waydroid.  Their hidden counterparts below are the Android-only route.
ATTRS{name}=="NVTCapacitivePenM80p", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="waydroid-pen-m80p", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/xiaomi-focus-pen", OPTIONS+="link_priority=100", ENV{ID_INPUT}="1", ENV{ID_INPUT_TABLET}="1", GOTO="waydroid_pen_mode_end"
ATTRS{name}=="NVTCapacitivePenP81c", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="waydroid-pen-p81c", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", ENV{ID_INPUT}="1", ENV{ID_INPUT_TABLET}="1", GOTO="waydroid_pen_mode_end"

# Android-only pen proxies.  They are permanently created by relay, hidden
# from desktop input, and exposed through stable LXC mount symlinks.
ATTRS{name}=="NVTCapacitivePenM80p", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="waydroid-android-pen-m80p", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-android-pen-m80p", OPTIONS+="link_priority=-100", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"
ATTRS{name}=="NVTCapacitivePenP81c", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="waydroid-android-pen-p81c", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-android-pen-p81c", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"

# Driver-created model nodes are hidden from libinput.  They remain available
# to the relay, which identifies them by name, BUS_VIRTUAL, VID/PID and phys.
ATTRS{name}=="NVTCapacitivePenM80p", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="input/pen", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-pen", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"
ATTRS{name}=="NVTCapacitivePenP81c", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3654", ATTRS{phys}=="input/pen_p81c", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-pen-pro", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"

# Ordinary M80p buttons use this Android-only keyboard side channel when a
# Waydroid window is focused in desktop mode.  It carries BTN_STYLUS/2 only.
ATTRS{name}=="Xiaomi Focus Pen Buttons", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3655", ATTRS{phys}=="waydroid-pen-buttons", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-android-buttons", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"

# Desktop Pro gesture proxy.  Pointer properties plus ID_INPUT_MOUSE make
# KWin/libinput expose the device with CAP_POINTER while retaining BTN_6..9.
ATTRS{name}=="Xiaomi Focus Pen Pro Gestures", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3655", ATTRS{phys}=="waydroid-gesture-relay", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEY}="1", ENV{ID_INPUT_MOUSE}="1", ENV{ID_INPUT_POINTER}="1", GOTO="waydroid_pen_mode_end"

# Android Pro gesture proxy.  It is created only while the physical gestures
# source exists and is mounted at event5 when the container is synced.
ATTRS{name}=="Xiaomi Focus Pen Pro Gestures", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="2717", ATTRS{id/product}=="3655", ATTRS{phys}=="waydroid-gesture-android", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-android-gestures", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"

# Physical Pro gestures source.  It is optional and hidden from libinput.
ATTRS{name}=="Xiaomi Focus Pen Pro Gestures", ATTRS{id/bustype}=="0006", ATTRS{id/vendor}=="0022", ATTRS{id/product}=="5081", ATTRS{phys}=="input/pen_p81c/gestures", OWNER="@USER_UID@", GROUP="@ANDROID_INPUT_GROUP@", MODE="0660", SYMLINK+="input/waydroid-pen-gestures", ENV{LIBINPUT_IGNORE_DEVICE}="1", GOTO="waydroid_pen_mode_end"

LABEL="waydroid_pen_mode_end"
