[Unit]
Description=Stable Xiaomi pen proxy for GNOME and Waydroid
Requires=xiaomi-sheng-thp.service
After=xiaomi-sheng-thp.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/waydroid-pen-relay
ExecStartPost=/usr/bin/bash -c 'for ((i=0; i<100; i++)); do [[ -e /dev/input/waydroid-pen ]] && exit 0; sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=1
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
