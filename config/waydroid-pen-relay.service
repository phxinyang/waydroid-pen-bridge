[Unit]
Description=Stable Xiaomi pen proxies for the desktop and Waydroid
Requires=xiaomi-sheng-thp.service
After=xiaomi-sheng-thp.service
Wants=waydroid-pen-link-sync.path
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/waydroid-pen-relay
# The relay owns both model pen proxies and the ordinary-button side channel.
# Pro gestures are optional and must never block service startup.
ExecStartPost=/usr/bin/bash -c 'for ((i=0; i<100; i++)); do [[ -e /dev/input/waydroid-android-pen-m80p && -e /dev/input/waydroid-android-pen-p81c && -e /dev/input/waydroid-android-buttons ]] && exit 0; sleep 0.1; done; exit 1'
ExecStartPost=-/usr/local/libexec/waydroid-pen-mode sync
Restart=on-failure
RestartSec=1
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
